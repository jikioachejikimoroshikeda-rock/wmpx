<Window
    x:Class="Wmpx.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WMP X — Windows Media Player Next">
    <Grid Background="#101A2A">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>

        <Grid Grid.Column="0" Background="#172438" Padding="14,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0,0,24">
                <Border Width="40" Height="40" CornerRadius="12" Background="#1685F5">
                    <TextBlock Text="▶" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Windows Media Player" FontSize="13" FontWeight="SemiBold" />
                    <TextBlock Text="Next · Escritorio" FontSize="11" Foreground="#AEBBD0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="5">
                <Button Content="⌂    Inicio" HorizontalContentAlignment="Left" Click="Home_Click" />
                <Button Content="♫    Música" HorizontalContentAlignment="Left" Click="Music_Click" />
                <Button Content="▣    Vídeos" HorizontalContentAlignment="Left" Click="Videos_Click" />
                <Button Content="◉    Podcasts" HorizontalContentAlignment="Left" Click="Podcasts_Click" />
                <Button Content="☷    Listas de reproducción" HorizontalContentAlignment="Left" Click="Playlists_Click" />
                <Button Content="▤    Biblioteca" HorizontalContentAlignment="Left" Click="Library_Click" />
            </StackPanel>
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="8,0,0,16">
                <TextBlock Text="BIBLIOTECAS" FontSize="10" Foreground="#92A2B8" Margin="0,0,0,8" />
                <TextBlock Text="📁  Música" Margin="0,5" />
                <TextBlock Text="🎬  Vídeos" Margin="0,5" />
                <TextBlock Text="🎙  Podcasts" Margin="0,5" />
                <TextBlock Text="📚  Audiolibros" Margin="0,5" />
                <TextBlock Text="📻  Radio" Margin="0,5" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="Reproductor de escritorio para Windows" FontSize="10" Foreground="#91A0B4" TextWrapping="Wrap" />
        </Grid>

        <Grid Grid.Column="1" Grid.Row="0" Padding="24,18,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Buscar música, vídeos y más..." MaxWidth="520" HorizontalAlignment="Left" />
                <Button Grid.Column="1" Content="⚙  Configuración" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Padding="16,12,24,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                        <Border Width="300" Height="300" MaxWidth="360" MaxHeight="360" CornerRadius="12" Background="#344E70">
                            <Grid>
                                <TextBlock Text="✦" FontSize="70" Foreground="#D9E7F5" Opacity="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="WMP X" FontSize="18" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="TrackTitle" Text="Selecciona música para empezar" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TrackArtist" Text="Tu biblioteca" FontSize="14" Foreground="#B8C5D6" HorizontalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Grid.Row="1" Text="Abre archivos de audio de tu PC para reproducirlos" HorizontalAlignment="Center" Foreground="#B8C5D6" Margin="0,0,0,12" />
                    <Grid Grid.Row="2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ElapsedText" Text="0:00" VerticalAlignment="Center" FontSize="11" Foreground="#B8C5D6" />
                        <Slider x:Name="PositionSlider" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="PositionSlider_ValueChanged" VerticalAlignment="Center" />
                        <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" VerticalAlignment="Center" FontSize="11" Foreground="#B8C5D6" />
                    </Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18" Margin="0,8,0,0">
                        <Button Content="⤨" Click="Shuffle_Click" ToolTipService.ToolTip="Aleatorio" />
                        <Button Content="|◀" Click="Previous_Click" ToolTipService.ToolTip="Anterior" />
                        <Button x:Name="PlayPauseButton" Content="▶" FontSize="20" Click="PlayPause_Click" ToolTipService.ToolTip="Reproducir o pausar" />
                        <Button Content="▶|" Click="Next_Click" ToolTipService.ToolTip="Siguiente" />
                        <Button Content="⟳" Click="Repeat_Click" ToolTipService.ToolTip="Repetir" />
                    </StackPanel>
                </Grid>
                <Border Grid.Column="1" Background="#19283B" CornerRadius="14" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Lista de reproducción" FontSize="16" FontWeight="SemiBold" Margin="6,6,6,16" />
                        <Button Grid.Row="1" Content="＋  Abrir archivos de audio" HorizontalAlignment="Stretch" Click="OpenFiles_Click" Margin="0,0,0,10" />
                        <ListView x:Name="TrackList" Grid.Row="2" IsItemClickEnabled="True" ItemClick="TrackList_ItemClick" SelectionMode="None" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,8" Spacing="3">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                        <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#AEBBD0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="QueueStatus" Grid.Row="3" Text="0 canciones" FontSize="11" Foreground="#AEBBD0" Margin="6,12,6,4" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#202F47" BorderBrush="#425571" BorderThickness="0,1,0,0" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="▶" Foreground="#62B5FF" FontSize="22" VerticalAlignment="Center" Margin="0,0,14,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="WMP X · Reproductor para Windows" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="Reproduce archivos de música de tu biblioteca local" FontSize="11" Foreground="#B8C5D6" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Aplicación de escritorio nativa" FontSize="11" Foreground="#B8C5D6" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
