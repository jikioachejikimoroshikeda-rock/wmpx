<Window
    x:Class="Wmpx.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvs="using:LibVLCSharp.Platforms.Windows"
    Title="WMP X — Windows Media Player Next">
    <Grid x:Name="RootLayout" Background="#101A2A">
        <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>

        <Border x:Name="SidebarPanel" Grid.Column="0" Background="#172438">
            <Grid Margin="14,18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0,0,24">
                    <Border Width="40" Height="40" CornerRadius="13" Background="{StaticResource AccentBrush}"><SymbolIcon Symbol="Play" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Windows Media Player" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="WMP X · Escritorio" FontSize="11" Foreground="#AEBBD0"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1" Spacing="5">
                    <Button HorizontalContentAlignment="Left" Click="Home_Click" Background="#293D58" CornerRadius="9"><StackPanel Orientation="Horizontal" Spacing="14"><SymbolIcon Symbol="Home"/><TextBlock Text="Inicio" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button HorizontalContentAlignment="Left" Click="Music_Click" Background="Transparent"><StackPanel Orientation="Horizontal" Spacing="14"><SymbolIcon Symbol="MusicInfo"/><TextBlock Text="Música" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button HorizontalContentAlignment="Left" Click="Videos_Click" Background="Transparent"><StackPanel Orientation="Horizontal" Spacing="14"><SymbolIcon Symbol="Video"/><TextBlock Text="Vídeos" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button HorizontalContentAlignment="Left" Click="Podcasts_Click" Background="Transparent"><StackPanel Orientation="Horizontal" Spacing="14"><SymbolIcon Symbol="Microphone"/><TextBlock Text="Podcasts" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button HorizontalContentAlignment="Left" Click="Playlists_Click" Background="Transparent"><StackPanel Orientation="Horizontal" Spacing="14"><SymbolIcon Symbol="Bullets"/><TextBlock Text="Listas de reproducción" VerticalAlignment="Center"/></StackPanel></Button>
                    <Button HorizontalContentAlignment="Left" Click="Library_Click" Background="Transparent"><StackPanel Orientation="Horizontal" Spacing="14"><SymbolIcon Symbol="Library"/><TextBlock Text="Biblioteca" VerticalAlignment="Center"/></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="8,0,0,16" Spacing="9">
                    <TextBlock Text="BIBLIOTECAS" FontSize="10" Foreground="#92A2B8" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Folder"/><TextBlock Text="Música" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Video"/><TextBlock Text="Vídeos" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Microphone"/><TextBlock Text="Podcasts" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="Library"/><TextBlock Text="Audiolibros" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10"><SymbolIcon Symbol="RadioButton"/><TextBlock Text="Radio" VerticalAlignment="Center"/></StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="3" Text="Tu música, a tu manera" FontSize="10" Foreground="#91A0B4" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,18,18,12">
            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border MaxWidth="520" HorizontalAlignment="Left" CornerRadius="20" Background="#20FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="12,0">
                    <Grid Height="38" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><SymbolIcon Symbol="Find" VerticalAlignment="Center" Foreground="#B8C5D6"/><AutoSuggestBox x:Name="SearchBox" Grid.Column="1" PlaceholderText="Buscar música, vídeos y más..." Background="Transparent" BorderThickness="0" VerticalAlignment="Center"/></Grid>
                </Border>
                <Button Grid.Column="1" Click="Settings_Click" Background="Transparent" ToolTipService.ToolTip="Personalizar apariencia"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Setting"/><TextBlock Text="Personalizar" VerticalAlignment="Center"/></StackPanel></Button>
            </Grid>
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="16,12,24,10">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel x:Name="AudioContent" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                        <Border x:Name="AlbumCover" Width="300" Height="300" MaxWidth="360" MaxHeight="360" CornerRadius="14" Background="#344E70" BorderBrush="#425571" BorderThickness="1"><Grid><TextBlock Text="✦" FontSize="70" Foreground="#D9E7F5" Opacity="0.8" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBlock Text="WMP X" FontSize="18" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"/></Grid></Border>
                        <TextBlock x:Name="TrackTitle" Text="Selecciona música para empezar" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TrackArtist" Text="Tu biblioteca" FontSize="14" Foreground="#B8C5D6" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Grid x:Name="VideoContent" Visibility="Collapsed" Background="Black" CornerRadius="12">
                        <lvs:VideoView x:Name="VideoSurface"/>
                        <StackPanel x:Name="VideoEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Background="#C0101A2A" Padding="24" CornerRadius="12">
                            <SymbolIcon Symbol="Video" Width="34" Height="34" HorizontalAlignment="Center"/>
                            <TextBlock Text="Abre un vídeo para reproducirlo" FontSize="16" HorizontalAlignment="Center"/>
                            <TextBlock Text="MP4 · MKV · AVI · MOV · WebM y más" FontSize="12" Foreground="#B8C5D6" HorizontalAlignment="Center"/>
                            <Button Click="OpenMedia_Click" HorizontalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="OpenFile"/><TextBlock Text="Abrir vídeos" VerticalAlignment="Center"/></StackPanel></Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="StatusText" Grid.Row="1" Text="Abre archivos de audio de tu PC para reproducirlos" HorizontalAlignment="Center" Foreground="#B8C5D6" Margin="0,0,0,12"/>
                    <Grid Grid.Row="2" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ElapsedText" Text="0:00" VerticalAlignment="Center" FontSize="11" Foreground="#B8C5D6"/><Slider x:Name="PositionSlider" Grid.Column="1" Minimum="0" Maximum="100" ValueChanged="PositionSlider_ValueChanged" VerticalAlignment="Center"/><TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" VerticalAlignment="Center" FontSize="11" Foreground="#B8C5D6"/></Grid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Margin="0,8,0,0">
                        <Button x:Name="ShuffleButton" Click="Shuffle_Click" ToolTipService.ToolTip="Aleatorio" Background="Transparent"><SymbolIcon Symbol="Shuffle"/></Button>
                        <Button Click="Previous_Click" ToolTipService.ToolTip="Anterior" Background="Transparent"><SymbolIcon Symbol="Previous"/></Button>
                        <Button x:Name="PlayPauseButton" Click="PlayPause_Click" ToolTipService.ToolTip="Reproducir o pausar" Background="{StaticResource AccentBrush}" CornerRadius="28" Width="54" Height="54"><SymbolIcon Symbol="Play"/></Button>
                        <Button Click="Next_Click" ToolTipService.ToolTip="Siguiente" Background="Transparent"><SymbolIcon Symbol="Next"/></Button>
                        <Button x:Name="RepeatButton" Click="Repeat_Click" ToolTipService.ToolTip="Repetir" Background="Transparent"><SymbolIcon Symbol="RepeatAll"/></Button>
                    </StackPanel>
                </Grid>
                <Border x:Name="QueuePanel" Grid.Column="1" Background="#19283B" CornerRadius="16" Padding="12" BorderBrush="#20FFFFFF" BorderThickness="1">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="9" Margin="6,6,6,16"><SymbolIcon x:Name="QueueIcon" Symbol="Bullets"/><TextBlock x:Name="QueueTitle" Text="Lista de reproducción" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
                        <Button x:Name="OpenMediaButton" Grid.Row="1" HorizontalAlignment="Stretch" Click="OpenMedia_Click" Margin="0,0,0,10" Background="#22FFFFFF" CornerRadius="9"><StackPanel Orientation="Horizontal" Spacing="9"><SymbolIcon x:Name="OpenMediaIcon" Symbol="Add"/><TextBlock x:Name="OpenMediaLabel" Text="Abrir archivos de audio" VerticalAlignment="Center"/></StackPanel></Button>
                        <ListView x:Name="TrackList" Grid.Row="2" IsItemClickEnabled="True" ItemClick="TrackList_ItemClick" SelectionMode="None" Background="Transparent"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="4,8" Spacing="3"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="13"/><TextBlock Text="{Binding Artist}" FontSize="11" Foreground="#AEBBD0"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
                        <TextBlock x:Name="QueueStatus" Grid.Row="3" Text="0 elementos" FontSize="11" Foreground="#AEBBD0" Margin="6,12,6,4"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border x:Name="FooterPanel" Grid.Row="1" Grid.ColumnSpan="2" Background="#202F47" BorderBrush="#30445F" BorderThickness="0,1,0,0" Padding="18,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><SymbolIcon Symbol="MusicInfo" Foreground="{StaticResource AccentBrush}" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,14,0"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="WMP X · Reproductor para Windows" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="Audio y vídeo local con controles sencillos" FontSize="11" Foreground="#B8C5D6"/></StackPanel><TextBlock Grid.Column="2" Text="Diseñado para disfrutar" FontSize="11" Foreground="#B8C5D6" VerticalAlignment="Center"/></Grid>
        </Border>
        <Border x:Name="WindowFrame" Grid.ColumnSpan="2" Grid.RowSpan="2" IsHitTestVisible="False" BorderBrush="#425571" BorderThickness="0" CornerRadius="14"/>
    </Grid>
</Window>
